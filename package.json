{
	"name": "@type32/codemirror-rich-obsidian-editor",
	"version": "0.1.1",
	"description": "OFM Editor Component for Nuxt.",
	"repository": "Type-32/codemirror-rich-obsidian",
	"license": "MIT",
	"type": "module",
	"private": false,
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepack": "bunx nuxt-module-build build",
		"dev": "bun run dev:prepare && bunx nuxi dev playground",
		"dev:build": "bunx nuxi build playground",
		"dev:prepare": "bunx nuxt-module-build build --stub && bunx nuxt-module-build prepare && bunx nuxi prepare playground",
		"release": "bun run prepack && bunx changelogen --release && bun publish && git push --follow-tags",
		"lint": "bunx eslint .",
		"test": "bunx vitest run",
		"test:watch": "bunx vitest watch",
		"test:types": "bunx vue-tsc --noEmit && cd playground && bunx vue-tsc --noEmit"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.0",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/lang-yaml": "^6.1.2",
		"@codemirror/language": "^6.12.1",
		"@codemirror/language-data": "^6.5.2",
		"@hsorby/vue3-katex": "0.6.0-rc.7",
		"@lezer/markdown": "^1.6.3",
		"@nuxt/image": "2.0.0",
		"@nuxt/kit": "^4.2.2",
		"@nuxt/ui": "^4.4.0",
		"@tiptap/extension-collaboration": "^3.16.0",
		"@tiptap/extension-node-range": "^3.16.0",
		"@tiptap/y-tiptap": "^3.0.1",
		"alfaaz": "^1.1.0",
		"codemirror": "^6.0.2",
		"js-yaml": "^4.1.1",
		"katex": "^0.16.27",
		"lezer-markdown-obsidian": "^0.0.3",
		"markdown-it": "^14.1.0",
		"markdown-it-obsidian-callouts": "^0.3.3",
		"tailwindcss": "^4.1.18",
		"vue-codemirror6": "^1.4.1",
		"yjs": "^13.6.29"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.86",
		"@iconify-json/simple-icons": "^1.2.67",
		"@nuxt/devtools": "^3.1.1",
		"@nuxt/eslint-config": "^1.12.1",
		"@nuxt/fonts": "0.12.1",
		"@nuxt/icon": "2.2.1",
		"@nuxt/module-builder": "^1.0.2",
		"@nuxt/schema": "^4.2.2",
		"@nuxt/test-utils": "^3.23.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.0.10",
		"changelogen": "^0.6.2",
		"eslint": "^9.39.2",
		"nuxt": "^4.2.2",
		"typescript": "~5.9.3",
		"vitest": "^4.0.17",
		"vue-tsc": "^3.2.2"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"@tailwindcss/oxide",
		"core-js",
		"esbuild",
		"sharp",
		"unrs-resolver",
		"vue-demi",
		"js-yaml",
		"alfaaz"
	]
}
