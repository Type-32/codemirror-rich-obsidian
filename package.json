{
  "name": "@type32/codemirror-rich-obsidian-editor",
  "version": "0.1.34",
  "description": "OFM Editor Component for Nuxt.",
  "repository": "https://github.com/Type-32/codemirror-rich-obsidian",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpx nuxt-module-build build",
    "dev": "pnpm run dev:prepare && pnpx nuxi dev playground",
    "dev:build": "pnpx nuxi build playground",
    "dev:prepare": "pnpx nuxt-module-build build --stub && pnpx nuxt-module-build prepare && pnpx nuxi prepare playground",
    "release": "pnpm run prepack && pnpx changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "pnpx eslint .",
    "test": "pnpx vitest run",
    "test:watch": "pnpx vitest watch",
    "test:types": "pnpx vue-tsc --noEmit && cd playground && pnpx vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "alfaaz": "^1.1.0",
    "js-yaml": "^5.4.2",
    "lezer-markdown-obsidian": "^0.0.3",
    "markdown-it": "^15.0.2",
    "markdown-it-obsidian-callouts": "^0.3.5"
  },
  "peerDependencies": {
    "@catppuccin/codemirror": "^1.0.3",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/markdown": "^1.6.3",
    "@nuxt/ui": "^4.11.3",
    "codemirror": "^6.0.2",
    "katex": "^0.16.33",
    "tailwindcss": "^4.2.1",
    "vue-codemirror6": "^1.4.2"
  },
  "peerDependenciesMeta": {
    "@catppuccin/codemirror": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@catppuccin/codemirror": "^1.0.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@lezer/common": "^1.5.3",
    "@lezer/markdown": "^1.7.2",
    "@nuxt/devtools": "^4.0.0-beta.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "changelogen": "^0.6.2",
    "codemirror": "^6.0.2",
    "eslint": "^10.12.0",
    "katex": "^0.19.0",
    "nuxt": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "vue-codemirror6": "^1.7.0",
    "vue-tsc": "^3.3.12"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "core-js",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi",
    "js-yaml",
    "alfaaz"
  ]
}
