{
  "name": "@type32/codemirror-rich-obsidian-editor",
  "version": "0.2.3",
  "description": "OFM Editor Component for Nuxt.",
  "repository": "https://github.com/Type-32/codemirror-rich-obsidian",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./kit": {
      "types": "./dist/runtime/kit/index.d.ts",
      "import": "./dist/runtime/kit/index.js"
    },
    "./ext": {
      "types": "./dist/runtime/ext/index.d.ts",
      "import": "./dist/runtime/ext/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "kit": [
        "./dist/runtime/kit/index.d.ts"
      ],
      "ext": [
        "./dist/runtime/ext/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "bunx nuxt-module-build build",
    "dev": "bun run dev:prepare && bunx nuxi dev playground",
    "dev:build": "bunx nuxi build playground",
    "dev:prepare": "bunx nuxt-module-build build --stub && bunx nuxt-module-build prepare && bunx nuxi prepare playground",
    "release": "bun run prepack && bunx changelogen --release && bun publish && git push --follow-tags",
    "lint": "bunx eslint .",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest watch",
    "test:types": "bunx vue-tsc --noEmit && cd playground && bunx vue-tsc --noEmit"
  },
  "dependencies": {
    "@catppuccin/codemirror": "^1.0.3",
    "@nuxt/kit": "^4.6.4",
    "alfaaz": "^1.1.0",
    "js-yaml": "^5.5.0",
    "lezer-markdown-obsidian": "^0.0.3",
    "markdown-it": "^15.0.3",
    "markdown-it-obsidian-callouts": "^0.3.5"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.6.3",
    "@nuxt/ui": "^4.12.0",
    "codemirror": "^6.0.2",
    "katex": "^0.16.33",
    "tailwindcss": "^4.2.1",
    "vue-codemirror6": "^1.4.2"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/simple-icons": "^1.2.101",
    "@lezer/common": "^1.5.5",
    "@lezer/markdown": "^1.8.1",
    "@nuxt/devtools": "^4.1.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.3.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "changelogen": "^0.6.2",
    "codemirror": "^6.0.2",
    "eslint": "^10.14.0",
    "katex": "^0.19.1",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.4",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "vue-codemirror6": "^1.7.0",
    "vue-tsc": "^3.3.14"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "core-js",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi",
    "js-yaml",
    "alfaaz"
  ],
  "packageManager": "bun@1.4.4"
}
